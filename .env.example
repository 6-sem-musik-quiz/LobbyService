# Copy this file to .env (it is gitignored) and fill in the values.
# Used by docker-compose.yml. Never commit .env.

# The JWT signing key UserService signs tokens with. It lives in OpenBao.
# Get it with (Tailscale on, OpenBao login):
#   bao kv get -field=signing-key kv/quiz/jwt
# Wrap it in single quotes if it contains $ or #.
JWT_SIGNING_KEY=
